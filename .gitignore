# Môi trường và cấu hình cá nhân
.env
*.env
backend/config/*

# Python cache & artifacts
**/__pycache__/
*.py[cod]

# Lịch sử làm bài cá nhân
**/history.json

# Du lieu runtime cua he thong thi (phien dang nhap, phong thi, bao loi) — khong commit
backend/data/users.json
backend/data/tokens.json
backend/data/rooms.json
backend/data/room_sessions.json
backend/data/*/reports.json

# Bỏ qua hoàn toàn thư mục data/ ở root (dữ liệu nguồn tại local, không track lên GitHub)
/data/

# Quy tắc tương tự cho backend/data/ (phục vụ deploy Vercel serverless)
backend/data/*/*
!backend/data/*/markdown/
!backend/data/*/markdown/**
!backend/data/*/note/
!backend/data/*/note/**
!backend/data/*/note.md/
!backend/data/*/note.md/**
!backend/data/*/subject_config.json
!backend/data/*/questions.json

# Scripts test output & backups
backend/scripts/test/
.backup_images/

.*/