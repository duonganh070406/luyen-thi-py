# Copy thành cau-hinh.env khi chạy local.
# SQLite mặc định: không cần DATABASE_URL.

# SQL Server 2022 / Express - Windows Authentication
# DATABASE_URL=mssql+pyodbc://@localhost\\SQLEXPRESS/LuyenThi?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes

# SQL Server Authentication
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost\\SQLEXPRESS/LuyenThi?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Nên thay bằng mật khẩu admin riêng trước khi chạy.
ADMIN_PASSWORD=change-me
PORT=3000
