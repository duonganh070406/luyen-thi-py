# File mau cau hinh — COMMIT file nay len git thoai mai.
# De chay du an: copy thanh `.env` roi sua theo may cua ban:
#   copy .env.sample .env   (Windows)   |   cp .env.sample .env   (Linux/Mac)
#
# Thu tu uu tien (cao -> thap):
#   1. Bien moi truong that (export / Docker environment / Vercel env)
#   2. File `.env` (may ca nhan, KHONG commit — da co trong .gitignore)
#   3. File `.env.sample` nay (gia tri mac dinh chung)

# ---- Thong tin ung dung ----
APP_NAME=Hệ thống kiểm tra đánh giá
APP_VERSION=1.0.0

# ---- Backend (FastAPI/Uvicorn) ----
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ---- Frontend (Vite dev server) ----
FRONTEND_PORT=3000
# Host ma Vite proxy toi backend (docker-compose tu dat = "backend")
VITE_PROXY_HOST=127.0.0.1
# Base URL ma frontend goi API. De TRONG khi chay dev (an theo Vite proxy /api).
# Vi du deploy tach biet: VITE_API_BASE_URL=https://api.vi-du.vn
VITE_API_BASE_URL=
# (Tuy chon) Ghi de ten/phien ban hien tren giao dien, mac dinh lay theo APP_NAME/APP_VERSION.
# VITE_APP_NAME=Hệ thống kiểm tra đánh giá
# VITE_APP_VERSION=1.0.0

# ---- CORS (cach nhau bang dau phay) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ---- Bao mat ----
# Production BAT BUOC dat JWT_SECRET rieng (chuoi dai, ngau nhien).
JWT_SECRET=doi-chuoi-nay-trong-production

# ---- Du lieu ----
# DATA_DIR=/duong/dan/tuy/chinh (mac dinh tu tim ./data)
